{
  "name": "fontra-embed",
  "private": true,
  "version": "0.1.0",
  "description": "Fontra glyph editor embedded in a static page, font backend proxied over postMessage",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "vendor": "./vendor.sh",
    "build": "webpack --config webpack.config.cjs --mode production && node fix-paths.mjs",
    "build:dev": "webpack --config webpack.config.cjs --mode development",
    "verify": "node harness/verify.mjs"
  },
  "workspaces": [
    "vendor/fontra/src-js/*"
  ],
  "devDependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "babel-loader": "^10.0.0",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "html-bundler-webpack-plugin": "^4.21.1",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "bezier-js": "^6.1.4",
    "fflate": "^0.8.2",
    "lib-font": "^2.4.3"
  }
}